# carmind demo settings. Copy to .env (git-ignored); never commit .env.
# Provider: fake (default, no network), anthropic or openai.
CARMIND_PROVIDER=fake
# Bring your own key to use a real provider.
ANTHROPIC_API_KEY=
CARMIND_ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
CARMIND_OPENAI_MODEL=
# luna, the constrained choices: on (the demo default) lets a language model infer listed car-history facts that can only tighten the verdict, and pick one of several matched drivable lights, from closed lists; off makes no model call.
LUNA_MODE=on
